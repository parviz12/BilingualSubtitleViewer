<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />
        <Button
            android:id="@+id/openButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/open"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <Button
            android:id="@+id/mediaButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/open_media"
            android:textSize="11sp"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/videoToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/hide_video"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:visibility="gone" />
        <Button
            android:id="@+id/speedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="1.0x"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:visibility="gone" />
        <Button
            android:id="@+id/loopButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/loop_off"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:visibility="gone" />
        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="middle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/no_file"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="0dp"
        android:background="#000000"
        android:visibility="visible"
        app:show_timeout="0"
        app:controller_auto_show="true" />

    <androidx.media3.ui.PlayerControlView
        android:id="@+id/playerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:visibility="gone"
        app:show_timeout="0"
        app:show_rewind_button="true"
        app:show_fast_forward_button="true" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:minHeight="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="2dp"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:importantForAutofill="no" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtitleList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="1dp"
            android:paddingBottom="1dp" />
        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/open_subtitle_message"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:padding="20dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/navigationPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@color/panel">
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            android:padding="2dp" />
        <TextView
            android:id="@+id/currentSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:gravity="center"
            android:textSize="16sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"
            android:padding="4dp"
            android:textIsSelectable="true" />
        <TextView
            android:id="@+id/positionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0 / 0"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">
            <Button
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:minHeight="0dp"
                android:layout_weight="1"
                android:text="@string/previous"
                android:textSize="12sp"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:minHeight="0dp"
                android:layout_weight="1"
                android:text="@string/next"
                android:textSize="12sp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>