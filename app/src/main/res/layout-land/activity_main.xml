<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background">

    <!-- LEFT: video and media controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.90"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:text="@string/no_file"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:visibility="gone"
            app:use_controller="false"/>

        <LinearLayout
            android:id="@+id/playerControls"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="▶"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="43dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00:00"
                android:textSize="10sp"
                android:textColor="@color/text_primary"/>
            <SeekBar
                android:id="@+id/timelineSeekBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:maxHeight="32dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:progressDrawable="@drawable/timeline_progress"
                android:thumb="@drawable/timeline_thumb"
                android:splitTrack="false"
                android:contentDescription="Video timeline"/>
            <TextView
                android:id="@+id/durationTimeText"
                android:layout_width="43dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00:00"
                android:textSize="10sp"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/openButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/open"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/mediaButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/open_media"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/videoToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/hide_video"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:visibility="gone"/>
            <Button
                android:id="@+id/speedButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="1.0x"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:visibility="gone"/>
            <Button
                android:id="@+id/loopButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/loop_off"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT: subtitle list, search and navigation -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.10"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:layout_marginBottom="2dp"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:background="@drawable/search_border"
            android:importantForAutofill="no"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subtitleList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"/>
            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/open_subtitle_message"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:padding="10dp"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navigationPanel"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/panel">
            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/currentSubtitleText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/positionText"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0 / 0"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"/>
            <Button
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/previous"
                android:textSize="10sp"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/navigationPlayPauseButton"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="▶"
                android:textSize="15sp"
                android:contentDescription="Play/Pause"/>
            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/next"
                android:textSize="10sp"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
